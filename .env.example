# Copy this file to .env.local at the repository root and fill in values.
# Placeholder values only. Never commit real secrets (.env and .env.local are git-ignored).

# ---- API (apps/api) ----
NODE_ENV=development
# Port the NestJS API listens on.
API_PORT=3001
# Browser origin allowed to call the API (the Next.js web app).
CORS_ORIGIN=http://localhost:3000
# Clients to monitor (see clients.local.example.json). Git-ignored. Missing = one demo client.
CLIENTS_FILE=clients.local.json

# ---- Sources ----
# demo  = invented demo data
# monid = real data through Monid (https://monid.ai/docs/api/overview)
LINKEDIN_SOURCE=demo
NEWS_SOURCE=demo
# Instagram, TikTok and YouTube have no demo data: "demo" shows them as Not connected.
INSTAGRAM_SOURCE=demo
TIKTOK_SOURCE=demo
YOUTUBE_SOURCE=demo

# ---- Engagement messages ----
# template = built-in template, nothing leaves the app (default)
# claude   = Claude drafts the message. Sends the brand name and post text to Anthropic,
#            so only switch on once that is cleared. Needs ANTHROPIC_API_KEY (or `ant auth login`).
MESSAGE_DRAFTER=template
# ANTHROPIC_API_KEY=

# ---- Sending email (SendGrid) ----
# Leave SENDGRID_API_KEY empty and the app never sends email (reps send from their own mailbox).
# Set it to show a "Send email" button on drafts. Create a key with "Mail Send" access only:
# SendGrid > Settings > API Keys. The From address must be a verified sender, or on a domain
# authenticated in SendGrid > Settings > Sender Authentication.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Fabulate
# Where replies go (optional; default is SENDGRID_FROM_EMAIL).
SENDGRID_REPLY_TO=
# true = SendGrid checks each email but delivers nothing. Use while testing.
SENDGRID_SANDBOX=true
# Replies shown in the app (optional). Point the MX record of a subdomain (e.g. replies.example.com)
# at mx.sendgrid.net, then in SendGrid > Settings > Inbound Parse add that domain with the URL
#   https://<your-api-host>/inbound/sendgrid?key=<SENDGRID_INBOUND_KEY>
# (leave "POST the raw, full MIME message" unticked). Each thread's Reply-To becomes
# reply+<token>@<SENDGRID_INBOUND_DOMAIN>. Needs REDIS_URL so threads survive restarts.
SENDGRID_INBOUND_DOMAIN=
# 24+ random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SENDGRID_INBOUND_KEY=

# ---- Monid ----
# Create a key at https://app.monid.ai/access/api-keys (shown once).
MONID_API_KEY=
MONID_BASE_URL=https://api.monid.ai
# Chosen with: pnpm monid discover "<query>" then pnpm monid inspect <provider> <endpoint>
MONID_LINKEDIN_PROVIDER=
MONID_LINKEDIN_ENDPOINT=
MONID_NEWS_PROVIDER=
MONID_NEWS_ENDPOINT=
# Profiles exist for: anyapi /instagram.user_posts, anyapi /tiktok.profile_videos,
# anyapi /youtube.channel_videos (adapters/outbound/monid/profiles/).
MONID_INSTAGRAM_PROVIDER=
MONID_INSTAGRAM_ENDPOINT=
MONID_TIKTOK_PROVIDER=
MONID_TIKTOK_ENDPOINT=
MONID_YOUTUBE_PROVIDER=
MONID_YOUTUBE_ENDPOINT=
# Tuning knobs (not Monid-published limits). Defaults shown; review before production.
# MONID_REQUEST_TIMEOUT_MS=30000
# MONID_MAX_RETRIES=3
# MONID_RETRY_BASE_DELAY_MS=1000
# MONID_POLL_INTERVAL_MS=5000
# MONID_RUN_TIMEOUT_MS=120000

# ---- Web (apps/web) ----
# Base URL the web app uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Job queue ────────────────────────────────────────────────────────────────
# With REDIS_URL, monitoring runs use BullMQ on Redis: one job per brand account,
# retries with backoff, jobs survive restarts, and several API instances share the work.
# Without it, an in-process queue with the same rules is used (jobs lost on restart).
# REDIS_URL=redis://localhost:6379
# REDIS_PREFIX=signal-monitor
# Accounts checked at the same time.
# MONITORING_CONCURRENCY=4
# Tries per account, including the first; retries wait 5s, 10s, 20s...
# MONITORING_JOB_ATTEMPTS=3
# MONITORING_RETRY_DELAY_MS=5000
# Most checks started per minute (BullMQ only). Leave empty for no limit.
# MONITORING_MAX_CHECKS_PER_MINUTE=
# Automatic runs (needs REDIS_URL), cron pattern in Sydney time. Example: 8am weekdays.
# MONITORING_SCHEDULE_CRON=0 8 * * 1-5
# Only posts from the last this-many days are collected and shown (0 = no limit).
# MONITORING_LOOKBACK_DAYS=90
# "Run monitoring" skips accounts checked less than this many minutes ago, so a repeat
# click is quick. "Check now" on a brand always checks. 0 = always check every account.
# MONITORING_RECHECK_AFTER_MINUTES=60

# ── Testing limits (leave unset in production: no limits) ────────────────────
# Keep at most this many newest posts per account per check. LinkedIn and news also
# ask Monid for fewer; Instagram, TikTok and YouTube return one page either way.
# MONID_MAX_POSTS_PER_ACCOUNT=5
# Show only signals scoring at least this (50 = Medium and High). Lower ones are
# still stored, just hidden.
# SIGNALS_MIN_SCORE=50

# ── Sign-in (Clerk) ──────────────────────────────────────────────────────────
# From the Clerk dashboard: your application > Configure > API keys.
# The publishable key is safe in the browser; the secret key stays on the servers.
# With CLERK_SECRET_KEY set, the API also rejects requests without a signed-in user
# (GET /health stays open).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# Front-end origins whose sessions the API accepts (comma-separated). Default: CORS_ORIGIN.
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
